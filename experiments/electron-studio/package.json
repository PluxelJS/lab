{
	"name": "@report-template-studio/app",
	"private": true,
	"files": [
		"dist",
		"financial-document-assets",
		"package.json",
		"README.md",
		"examples",
		"workspace-assets"
	],
	"type": "module",
	"main": "dist/electron/main.mjs",
	"exports": {
		"./plugin": {
			"types": "./dist/plugin.d.mts",
			"@pluxel/hmr": "./src/backend/plugin.ts",
			"default": "./dist/plugin.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"default": "./dist/client.mjs"
		},
		"./contracts": {
			"types": "./dist/contracts.d.mts",
			"default": "./dist/contracts.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"default": "./dist/runtime.mjs"
		}
	},
	"scripts": {
		"build": "vp run compile",
		"start": "node ../../scripts/check-worksplit-native.mjs . && electron .",
		"dev": "node scripts/dev.mjs",
		"test": "vp run check-tests",
		"test:discovery": "vp run check-discovery",
		"typecheck": "vp run check-types",
		"package": "node scripts/package.mjs",
		"test:desktop": "node tests/desktop.mjs",
		"test:worksplit": "node tests/worksplit-desktop.mjs",
		"test:desktop-recovery": "node tests/desktop-recovery.mjs",
		"test:runtime": "node tests/runtime.mjs"
	},
	"dependencies": {
		"@assistant-ui/react": "catalog:",
		"@assistant-ui/react-streamdown": "catalog:",
		"@assistant-ui/styles": "catalog:",
