		"@pluxel/host": "catalog:",
		"@pluxel/plugin-fonts": "catalog:",
		"@pluxel/plugin-typst": "*",
		"@pluxel/services": "catalog:",
		"@streamdown/cjk": "catalog:",
		"@streamdown/code": "catalog:",
		"@tabler/icons-react": "catalog:",
